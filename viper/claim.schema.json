{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hidden-viper/claim.schema.json",
  "title": "Hidden Viper Claim",
  "type": "object",
  "required": [
    "kind",
    "target"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "file_exists",
        "file_sha256",
        "file_contains",
        "tcp_listen",
        "http_status"
      ]
    },
    "target": {},
    "expected": {},
    "host": {
      "type": "string"
    },
    "timeoutSeconds": {
      "type": "number",
      "minimum": 0
    },
    "encoding": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": ["file_exists", "tcp_listen"]
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "expected": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
